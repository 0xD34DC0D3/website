---
interface Props {
  id: string;
  index: string;
  title: string;
  lede?: string;
}
const { id, index, title, lede } = Astro.props;
---

<section id={id} class="scroll-mt-24 border-b-brut border-ink py-12 last:border-b-0">
  <p class="eyebrow mb-2">{index}</p>
  <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
  {lede && <p class="mt-3 max-w-2xl text-muted">{lede}</p>}
  <div class="mt-8">
    <slot />
  </div>
</section>
