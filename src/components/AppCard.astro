---
import type { App } from "../data/apps";

interface Props {
  app: App;
  index?: number;
}

const { app, index } = Astro.props;
const Tag = app.href ? "a" : "div";
---

<Tag href={app.href} class:list={["brut group flex h-full flex-col gap-2 p-5", app.href && "brut-press"]}>
  <div class="flex items-start justify-between gap-4">
    <h3 class="font-display text-xl font-bold">{app.name}</h3>
    <span class:list={["badge", { live: "bg-accent", beta: "bg-tint-2", soon: "" }[app.status]]}>{app.status}</span>
  </div>
  <p class="text-sm text-muted">{app.tagline}</p>
  <div class="mt-auto flex items-center justify-between gap-4 pt-3">
    <span class="meta">{index !== undefined && `0x${index.toString(16).toUpperCase().padStart(2, "0")}`}</span>
    {
      app.href && (
        <span class="font-mono text-xs font-bold uppercase tracking-wider">
          Launch{" "}
          <span class="inline-block transition-transform motion-safe:group-hover:translate-x-1" aria-hidden="true">
            →
          </span>
        </span>
      )
    }
  </div>
</Tag>
