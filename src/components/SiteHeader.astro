---
import Logo from "./Logo.astro";
import { PUBLIC_AUTH_URL } from "astro:env/client";

const { pathname } = Astro.url;
const nav = [
  { href: "/#apps", label: "Apps" },
  { href: "/docs/design-guide", label: "Design guide", wideOnly: true },
];
const isCurrent = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
---

<header class="sticky top-0 z-20 border-b-brut border-ink bg-canvas">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/"><Logo /></a>
    <nav aria-label="Primary" class="flex items-center gap-1 font-mono text-xs font-bold uppercase tracking-wider sm:gap-2">
      {
        nav.map(({ href, label, wideOnly }) => (
          <a
            href={href}
            aria-current={isCurrent(href) ? "page" : undefined}
            class:list={["whitespace-nowrap border-brut-sm border-transparent px-2 py-1 hover:border-ink hover:bg-accent aria-[current=page]:border-ink aria-[current=page]:bg-accent sm:px-3", wideOnly && "hidden sm:inline"]}
          >
            {label}
          </a>
        ))
      }
      <a id="auth-link" href={`${PUBLIC_AUTH_URL}/login`} class="btn btn-primary btn-sm whitespace-nowrap">Sign in</a>
    </nav>
  </div>
</header>

<script>
  import { PUBLIC_AUTH_URL } from "astro:env/client";

  const link = document.getElementById("auth-link") as HTMLAnchorElement | null;
  if (link) {
    // Return here after signing in.
    link.href = `${PUBLIC_AUTH_URL}/login?next=${encodeURIComponent(location.href)}`;
    fetch("/api/me", { credentials: "same-origin" })
      .then((res) => (res.ok ? res.json() : null))
      .then((me: { email: string } | null) => {
        if (!me) return;
        link.href = `${PUBLIC_AUTH_URL}/`;
        link.textContent = "Account";
        link.title = `Signed in as ${me.email}`;
      })
      .catch(() => {});
  }
</script>
