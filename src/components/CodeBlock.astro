---
interface Props {
  code: string;
  label?: string;
}
const { code, label } = Astro.props;
---

<figure class="brut overflow-hidden bg-ink text-canvas">
  {label && <figcaption class="border-b-brut-sm border-canvas/20 px-4 py-2 font-mono text-xs uppercase tracking-wider text-accent">{label}</figcaption>}
  <pre tabindex="0" class="overflow-x-auto p-4 text-sm leading-relaxed"><code>{code}</code></pre>
</figure>
